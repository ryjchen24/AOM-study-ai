// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-py"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(cuid())
  googleId    String       @unique // Google OIDC `sub` — stable identity match key
  email       String       @unique
  displayName String
  avatarUrl   String? // Google `picture`; optional
  folders     Folder[]
  sessions    Session[]
  apiKeys     UserApiKey[]
  createdAt   DateTime     @default(now())
}

model Folder {
  id        String    @id @default(cuid())
  name      String
  color     String
  parentId  String?
  parent    Folder?   @relation("FolderTree", fields: [parentId], references: [id])
  children  Folder[]  @relation("FolderTree")
  order     Int       @default(0)
  sessions  Session[]
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
}

model Session {
  id        String    @id @default(cuid())
  title     String
  folderId  String?
  folder    Folder?   @relation(fields: [folderId], references: [id])
  provider  String    @default("anthropic")
  model     String
  messages  Message[]
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime  @updatedAt
  createdAt DateTime  @default(now())
}

model Message {
  id          String    @id @default(cuid())
  sessionId   String
  session     Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role        String // "user" | "assistant"
  kind        String    @default("chat") // "chat" | "note" — a note is authored by the
  //                                        user (role="user") but is free-written prose,
  //                                        not a question: render it as a plain block and
  //                                        don't send it to the model as Q&A history.
  text        String
  attachments Json?
  edited      Boolean   @default(false) // true once the user rewrote `text` by hand
  editedAt    DateTime?
  createdAt   DateTime  @default(now())
}

model UserApiKey {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String // "openai" | "anthropic" | "google" | "mistral"
  label        String? // optional nickname like "personal" or "work"
  encryptedKey Bytes // Fernet ciphertext — never stored or logged in plaintext
  last4        String // last 4 chars of the plaintext, for display only
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, provider, label])
}
